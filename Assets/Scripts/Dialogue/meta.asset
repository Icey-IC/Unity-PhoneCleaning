%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ee501b7d79b0bf645a5a94c1351e1ea5, type: 3}
  m_Name: meta
  m_EditorClassIdentifier: 
  lines:
  - type: 0
    text: "\u597D\u50CF\u51FA\u4E86\u4E00\u70B9\u5C0F\u5DEE\u9519\uFF0C\u4E0D\u8FC7\u65E0\u4F24\u5927\u96C5"
    options: []
  - type: 0
    text: "\u65F6\u95F4\u8FC7\u5F97\u771F\u5FEB\uFF0C\u770B\u6765\u8BC1\u636E\u5DF2\u7ECF\u90FD\u6D88\u9664\u4E86"
    options: []
  - type: 0
    text: "\u4F60\u597D\uFF0C\u5149\u987E\u6B64\u5929\u5730\uFF08\u6E38\u620F\uFF09\u7684\u5BA2\u4EBA\uFF0C\u5BF9\u4ED6\u4EEC\u65BD\u4EE5\u63F4\u624B\uFF0C\u60F3\u5FC5\u4E5F\u8BA9\u4F60\u5EA6\u8FC7\u4E86\u4E00\u6BB5\u5145\u5B9E\u7684\u65F6\u5149\u201D"
    options: []
  - type: 0
    text: "\u591A\u4E48\u53EF\u601C\u7684\u4EBA\u4EEC\u554A\uFF0C\u5BFB\u6C42\u516C\u5E73\u4E0E\u89E3\u8131\u5374\u56DB\u5904\u78B0\u58C1\uFF0C\u6211\u5F88\u540C\u60C5\u4ED6\u4EEC"
    options: []
  - type: 0
    text: "\u6BCF\u4E2A\u4EBA\u90FD\u6709\u90A3\u4E48\u5F3A\u70C8\u7684\u6028\u6068\u548C\u5FF5\u5934\uFF0C\u5374\u603B\u56E0\u4E3A\u4E00\u4E9B\u83AB\u987B\u6709\u7684\u969C\u788D\u65E0\u6CD5\u770B\u6E05\u771F\u6B63\u901A\u5F80\u5E78\u798F\u7684\u6377\u5F84"
    options: []
  - type: 0
    text: "\u6240\u4EE5\u6211\u63A8\u4E86\u4ED6\u4EEC\u4E00\u628A"
    options: []
  - type: 0
    text: "\u8BF4\u4E86\u8FD9\u4E48\u4E45\u8FD8\u6CA1\u81EA\u6211\u4ECB\u7ECD\u5462"
    options: []
  - type: 0
    text: "\u521D\u6B21\u89C1\u9762\uFF0C\u6211\u662F\u8FD9\u5BB6\u624B\u673A\u4FEE\u7406\u5E97\u7684\u4E3B\u4EBA"
    options: []
  - type: 0
    text: "\u5173\u4E8E\u4F60\u7684\u5076\u7136\u5230\u8BBF\uFF0C\u53EA\u662F\u8FD9\u4E2A\u4E16\u754C\u7684\u4E00\u4E2A\u5FAE\u4E0D\u8DB3\u9053\u7684\u5C0F\u63D2\u66F2"
    options: []
  - type: 0
    text: "\u6211\u731C\u4F60\u6216\u8BB8\u53EA\u662F\u88AB\u8FD9\u4E2A\u6E38\u620F\u7684\u8822\u540D\u5B57\u5438\u5F15\uFF0C\u6216\u8005\u5979\u4EEC\u5F3A\u70C8\u9080\u8BF7\u4F60\u8FC7\u6765\u8FDB\u884C\u6E38\u73A9"
    options: []
  - type: 0
    text: "\u5BF9\u4E86\uFF0C\u4E0D\u7528\u62C5\u5FC3\u6211\u4EB2\u7231\u7684\u59D4\u6258\u4EBA\u4EEC"
    options: []
  - type: 0
    text: "\u6211\u53EA\u662F\u65BD\u52A0\u4E86\u4E00\u70B9\u5C0F\u5C0F\u7684\u50AC\u7720\uFF0C\u4ED6\u4EEC\u4E0D\u8BB0\u5F97\u81EA\u5DF1\u505A\u8FC7\u4EC0\u4E48"
    options: []
  - type: 0
    text: "\u66F4\u4F55\u51B5\uFF0C\u8C01\u80FD\u60F3\u5230\u5462\uFF0C\u4E00\u4EF6\u770B\u4E0A\u53BB\u65E0\u4F24\u5927\u96C5\u7684\u5C0F\u4E8B\u5374\u8DB3\u591F
      \uFF0C\u541E\u566C\u4E00\u4E2A\u4EBA\u7684\u751F\u547D"
    options: []
  - type: 0
    text: "\u4E5F\u8BB8\u4F60\u5728\u4E0E\u4ED6\u4EEC\u7684\u77ED\u6682\u63A5\u89E6\u4E2D\u53D1\u73B0\u4E86\u4ED6\u4EEC\u7684\u75DB\u82E6\uFF0C\u4F46\u4F60\u6BD5\u7ADF\u65E0\u6CD5\u5F7B\u5E95\u611F\u540C\u8EAB\u53D7"
    options: []
  - type: 0
    text: "\u800C\u6211\u53EF\u4EE5\u901A\u8FC7\u201D\u50AC\u7720\u201C\u6765\u4E86\u89E3\u5230\u4ED6\u4EEC\u7684\u771F\u5B9E\u60F3\u6CD5"
    options: []
  - type: 0
    text: "\u4ED6\u4EEC\u7684\u4EC7\u4EBA\uFF0C\u4ED6\u4EEC\u7684\u75DB\u82E6\uFF0C\u4ED6\u4EEC\u7684\u65E0\u529B"
    options: []
  - type: 0
    text: "\u8FD9\u4E00\u5207\u90FD\u4EE4\u6211\u5FCD\u4E0D\u4F4F\u4F38\u51FA\u63F4\u624B\uFF0C\u65BD\u4EE5\u6B63\u4E49"
    options: []
  - type: 0
    text: "\u6240\u4EE5\u4ECE\u4ED6\u4EEC\u7684\u89C6\u89D2\u6765\u770B\u5927\u6982\u53EA\u662F\u5728\u5E73\u51E1\u7684\u4E00\u5929\u91CC\u68A6\u60F3\u6210\u771F\u4E86\u800C\u5DF2"
    options: []
  - type: 0
    text: "\u54E6\uFF0C\u8BF4\u7684\u597D\u50CF\u6709\u70B9\u591A\u4E86\uFF0C\u90A3\u4E48\u5728\u4E34\u522B\u4E4B\u524D\u5BB9\u6211\u591A\u5634\u4E00\u53E5\u5427"
    options: []
  - type: 0
    text: "\u4E0D\u8981\u60F3\u7740\u91CD\u542F\u6E38\u620F\u6216\u8005\u56DE\u6863\u6765\u6539\u53D8\u4ED6\u4EEC\uFF0C\u56E0\u4E3A\u5979\u4EEC\u538B\u6839\u6CA1\u505A\u8FD9\u5757\u7684\u529F\u80FD"
    options: []
  - type: 0
    text: "\u90A3\u4E48\uFF0C\u201C\u518D\u89C1\u201D\uFF0C\u89C1\u8BC1\u8005\uFF08\u73A9\u5BB6\uFF09\uFF0C\u8877\u5FC3\u795D\u60A8\u4E5F\u6709\u6109\u5FEB\u7684\u4E00\u5929\uFF01"
    options: []
