  m_Script: {fileID: 11500000, guid: ee501b7d79b0bf645a5a94c1351e1ea5, type: 3}
  m_Name: "\u767D\u566A\u97F3"
  m_EditorClassIdentifier: 
  lines:
  - type: 0
    text: "\u5927\u6982\u662F\u54EA\u53EA\u5C0F\u5BB6\u4F19\u843D\u6211\u624B\u673A\u4E0A\u4E0B\u8F7D\u4E0B\u6765\u7684\u5427\uFF0C\u4F46\u91CC\u9762\u7684\u97F3\u4E50\u6211\u548C\u5B69\u5B50\u4EEC\u90FD\u7231\u542C\uFF0C\u4EE4\u4EBA\u5FC3\u60C5\u5E73\u9759\u4E0D\u8BF4\uFF0C\u611F\u89C9\u50CF\u6709\u53EA\u624B\u5728\u8C03\u8282\u6211\u7684\u601D\u60F3\u4E00\u822C\uFF0C\u5F88\u5947\u5999\u7684\u611F\u89C9\u3002\u800C\u4E14\u5F88\u9002\u5408\u5728\u6211\u770B\u4E66\u7684\u65F6\u5019\u5F53\u80CC\u666F\u97F3"
    options: []
  - type: 1
    text: "\u539F\u6765\u9E66\u9E49\u4E5F\u4F1A\u559C\u6B22\u767D\u566A\u97F3\u554A\uFF0C\u771F\u795E\u5947\u3002"
    options: []
  - type: 1
    text: "\u4F46\u770B\u60A8\u624B\u673A\u7684\u72B6\u6001\uFF0C\u6211\u8FD8\u662F\u628A\u5B83\u5220\u4E86\u6BD4\u8F83\u597D\uFF0C\u4E07\u4E00\u5B83\u5C31\u662F\u5F39\u5E7F\u544A\u7684\u771F\u51F6\u5C31\u9EBB\u70E6\u4E86"
    options: []
