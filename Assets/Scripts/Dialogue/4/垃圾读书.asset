  m_Script: {fileID: 11500000, guid: ee501b7d79b0bf645a5a94c1351e1ea5, type: 3}
  m_Name: "\u5783\u573E\u8BFB\u4E66"
  m_EditorClassIdentifier: 
  lines:
  - type: 0
    text: "\u7535\u5B50\u4E66\u662F\u6BD4\u5B9E\u4F53\u4E66\u65B9\u4FBF\u4E00\u4E9B\uFF0C\u4F46\u6211\u8FD9\u4E2A\u8F6F\u4EF6\u8001\u662F\u5F39\u51FA\u5E7F\u544A\u6216\u8005\u770B\u4EC0\u4E48\u89C6\u9891\u624D\u80FD\u7EE7\u7EED\u5F80\u4E0B\u770B\uFF0C\u592A\u70E6\u4EBA\u4E86\uFF0C\u8FD9\u79CD\u4E66\u770B\u5230\u4E00\u534A\u88AB\u6253\u65AD\u7684\u611F\u89C9\u3002"
    options: []
  - type: 1
    text: "\u6211\u6709\u4E00\u4E2A\u5E73\u65F6\u7528\u7684\u611F\u89C9\u7279\u522B\u597D\u7684\u8BFB\u4E66\u8F6F\u4EF6\uFF0C\u4E0D\u4EC5\u4E66\u5168\u90E8\u514D\u8D39\uFF0C\u800C\u4E14\u6CA1\u6709\u4EFB\u4F55\u5E7F\u544A\u6253\u6270\uFF0C\u8981\u662F\u60A8\u4FE1\u7684\u8FC7\u6211\uFF0C\u6211\u5C31\u628A\u60A8\u73B0\u5728\u8FD9\u4E2A\u5220\u4E86\uFF0C\u4E0B\u4E2A\u65B0\u7684"
    options: []
  - type: 0
    text: "\u90A3\u53EF\u771F\u662F\u592A\u597D\u4E86\uFF0C\u53C8\u7ED9\u4F60\u6DFB\u9EBB\u70E6\u4E86"
    options: []
