  m_Script: {fileID: 11500000, guid: ee501b7d79b0bf645a5a94c1351e1ea5, type: 3}
  m_Name: "\u6728\u96D5"
  m_EditorClassIdentifier: 
  lines:
  - type: 0
    text: "\u6728\u5934\u7C7B\u7684\u5C0F\u88C5\u9970\u4E5F\u8BB8\u80FD\u8BA9\u8FD9\u7FA4\u5B69\u5B50\u611F\u5230\u4EB2\u8FD1\uFF0C\u6240\u4EE5\u6211\u73B0\u5728\u7167\u7740\u8FD9\u91CC\u9762\u7684\u4E00\u4E9B\u6559\u7A0B\u96D5\u96D5\u7B80\u5355\u7684\u5C0F\u4E1C\u897F\u7ED9\u5B83\u4EEC\u73A9\u73A9"
    options: []
  - type: 1
    text: "\u770B\u6765\u60A8\u6700\u8FD1\u8FDB\u6B65\u795E\u901F\uFF01\u6211\u5F88\u559C\u6B22\u60A8\u4E4B\u524D\u9001\u6211\u7684\u90A3\u4E2A\u624B\u673A\u652F\u67B6\uFF0C\u6728\u8D28\u7EB9\u7406\u6478\u4E0A\u53BB\u5B89\u5FC3\u53C8\u8212\u670D\u3002"
    options: []
