--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ee501b7d79b0bf645a5a94c1351e1ea5, type: 3}
  m_Name: "\u5F00\u5C40"
  m_EditorClassIdentifier: 
  lines:
  - type: 1
    text: "\u6B22\u8FCE\uFF01\u770B\u6765\u60A8\u7684\u624B\u673A\u53C8\u5361\u987F\u4E86\uFF1F"
    options: []
  - type: 0
    text: "\u6BCF\u6B21\u6253\u5F00\u8F6F\u4EF6\u5C31\u6709\u5E7F\u544A\u5F39\u4E0A\u6765\uFF0C\u5173\u90FD\u5173\u4E0D\u5B8C\uFF0C\u597D\u597D\u4E00\u4E2A\u8F6F\u4EF6\u8D39\u534A\u5929\u624D\u80FD\u6253\u5F00\uFF0C\u8FD9\u6B21\u4E5F\u8981\u9EBB\u70E6\u4F60\u5E2E\u6211\u770B\u770B\u4E86"
    options: []
  - type: 1
    text: "\u6CA1\u4E8B\uFF0C\u6211\u5C31\u5E72\u8FD9\u884C\u7684\uFF0C\u8BF4\u8D77\u6765\u4E0A\u6B21\u60A8\u63D0\u5230\u7684\u548C\u540C\u597D\u4E00\u8D77\u8054\u540D\u4E3E\u62A5
      \u8650\u9E1F\u7684\u4EBA\u7684\u4E8B\u60C5\u600E\u4E48\u6837\uFF1F\u8FD8\u987A\u5229\u5417\uFF1F"
    options: []
  - type: 0
    text: "\u73B0\u5728\u60C5\u51B5\u5F88\u96BE\u8BF4\u554A\uFF0C\u4ED6\u4E0D\u77E5\u9053\u600E\u4E48\u641E\u5230\u4E86\u5927\u5BB6\u7684\u4F4F\u5740\u548C\u59D3\u540D\uFF0C\u5F00\u59CB\u6328\u4E2A\u5A01\u80C1\u8D77\u6765\uFF0C\u6700\u8FD1\u751A\u81F3\u95F9\u5230\u4E86\u6211\u513F\u5B50\u90A3\u91CC\uFF0C\u771F\u662F\u5934\u75BC"
    options: []
  - type: 1
    text: "\u8D64\u88F8\u88F8\u7684\u5F00\u76D2\u5A01\u80C1\u554A\uFF0C\u8FD8\u95F9\u5230\u60A8\u513F\u5B50\u90A3\u91CC\u4E86\uFF1F"
    options: []
  - type: 0
    text: "\u662F\u554A\uFF0C\u4F46\u662F\u4ED6\u4EEC\u4F46\u51E1\u5BF9\u6211\u513F\u5B50\u51FA\u624B\uFF0C\u6211\u4E5F\u7EDD\u5BF9\u4E0D\u4F1A\u5BA2\u6C14\u7684\uFF0C\u6B7B\u4E5F\u8981\u628A\u4ED6\u6254\u76D1\u72F1\u91CC"
    options: []
  - type: 1
    text: "\u522B\u8BF4\u90A3\u4E48\u4E0D\u5409\u5229\u7684\u8BDD\uFF0C\u6211\u89C9\u5F97\u4ED6\u56A3\u5F20\u4E0D\u4E86\u591A\u4E45\u5C31
      \u4F1A\u6D88\u5931\u7684\uFF0C\u6BD5\u7ADF\u4ED6\u4E0D\u5360\u7406\u3002"
    options: []
  - type: 0
    text: "\u6211\u4E5F\u8FD9\u4E48\u60F3\u7684"
    options: []
