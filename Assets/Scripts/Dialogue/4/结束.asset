--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ee501b7d79b0bf645a5a94c1351e1ea5, type: 3}
  m_Name: "\u7ED3\u675F"
  m_EditorClassIdentifier: 
  lines:
  - type: 1
    text: "\u60A8\u7684\u624B\u673A\uFF0C\u8BF7\u6536\u597D"
    options: []
  - type: 0
    text: "\u8F9B\u82E6\u4E86\uFF0C\u5509\uFF0C\u8981\u662F\u73B0\u5728\u7684\u9752\u5E74\u80FD\u591A\u5B66\u5B66\u4F60\u5C31\u597D\u4E86"
    options: []
  - type: 0
    text: "\u800C\u4E0D\u662F\u4E00\u5929\u5230\u665A\u53EA\u4F1A\u5BF9\u90A3\u4E9B\u53EF\u601C\u7684\u5C0F\u751F\u547D\u4E0B\u624B"
    options: []
  - type: 1
    text: "\u662F\u554A\uFF0C\u90A3\u4E9B\u793E\u4F1A\u7684\u6E23\u6ED3\u8981\u662F\u81EA\u5DF1\u80FD\u662F\u5168\u6D88\u5931\uFF0C\u4E5F\u7B97\u5F97\u4E0A\u662F\u5BF9\u793E\u4F1A\u7684\u4E00\u70B9\u8D21\u732E\u5427"
    options: []
  - type: 0
    text: "\u4F46\u4E5F\u8BB8\u662F\u6559\u80B2\u7684\u95EE\u9898\u5427\uFF0C\u771F\u60F3\u597D\u597D\u9A82\u4E00\u987F\u6559\u51FA\u8FD9\u79CD\u5B69\u5B50\u7684\u8001\u5E08\u548C\u5BB6\u957F!"
    options: []
  - type: 0
    text: "\u5230\u5E95\u600E\u4E48\u628A\u4E00\u4E2A\u597D\u7AEF\u7AEF\u7684\u5B69\u5B50\u53D8\u6210\u73B0\u5728\u7684\u6A21\u6837"
    options: []
  - type: 1
    text: "\u54CE\u5440\uFF0C\u60A8\u4E5F\u6D88\u6D88\u6C14!\u6211\u63A5\u4E0B\u6765\u6CA1\u4EC0\u4E48\u6D3B\uFF0C\u9700\u8981\u966A\u60A8\u5230\u697C\u5E95\u4E0B\u5417?"
    options: []
  - type: 0
    text: "\u4E0D\u7528\u4E0D\u7528\uFF0C\u4ED6\u4E0D\u6562\u5728\u5927\u767D\u5929\u4E0B\u624B\u7684\uFF0C\u6211\u81EA\u5DF1\u4E00\u4E2A\u4EBA\u6CA1\u95EE\u9898\u7684\u3002"
    options: []
  - type: 1
    text: "\u662F\u5417?\u90A3\u795D\u60A8\u5E73\u5B89\u56DE\u5BB6"
    options: []
