  m_Script: {fileID: 11500000, guid: ee501b7d79b0bf645a5a94c1351e1ea5, type: 3}
  m_Name: "\u89C6\u9891"
  m_EditorClassIdentifier: 
  lines:
  - type: 0
    text: "\u4E4B\u524D\u548C\u5FAE\u4FE1\u91CC\u4E00\u4E9B\u4EBA\u8054\u540D\u5F55\u5236\u4E86\u62B5\u5236\u548C\u4E3E\u62A5\u7684\u89C6\u9891\u53D1\u5230\u8FD9\u4E0A\u9762\uFF0C\u5E0C\u671B\u66F4\u591A\u4EBA\u80FD\u7AD9\u51FA\u6765\u62B5\u5236\u548C\u8C34\u8D23\u8FD9\u79CD\u884C\u4E3A\u3002"
    options: []
  - type: 0
    text: "\u5E2E\u6211\u628A\u901A\u77E5\u5173\u4E0A\u5427\uFF0C\u4ED6\u7684\u53EB\u58F0\u592A\u96BE\u542C\u4E86\uFF0C\u65E9\u665A\u8981\u628A\u6211\u6C14\u6B7B\u8FC7\u53BB\u3002"
    options: []
  - type: 1
    text: "\u60A8\u5F53\u65F6\u8981\u662F\u91C7\u7EB3 \u6211\u7684\u610F\u89C1\u5C31\u597D\u4E86\uFF0C\u660E\u660E\u4F1A\u6709\u5F88\u591A\u8D5B\u535A\u6C34\u519B\u5E2E\u60A8\u7684\uFF0C\u60A8\u4E5F\u4E0D\u7528\u8001\u88AB\u90A3\u79CD\u4E1C\u897F\u5A01\u80C1"
    options: []
