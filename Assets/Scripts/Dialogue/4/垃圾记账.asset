  m_Script: {fileID: 11500000, guid: ee501b7d79b0bf645a5a94c1351e1ea5, type: 3}
  m_Name: "\u5783\u573E\u8BB0\u8D26"
  m_EditorClassIdentifier: 
  lines:
  - type: 0
    text: "\u4E4B\u524D\u513F\u5B50\u63D0\u9192\u6211\u8BF4\u6211\u5E94\u8BE5\u8BD5\u7740\u8BB0\u8BB0\u8D26\uFF0C\u514D\u5F97\u628A\u517B\u8001\u91D1\u5168\u82B1\u5230\u517B\u9E1F\uFF0C\u4E70\u4E66\u4E0A\uFF0C\u5BFC\u81F4\u81EA\u5DF1\u751F\u6D3B\u53D7\u4E8F\u635F\uFF0C\u6240\u4EE5\u6211\u968F\u4FBF\u6311\u4E86\u4E00\u4E2A\u4E0B\u4E0B\u6765\uFF0C\u4F46\u611F\u89C9\u4E0D\u592A\u597D\u7528\u5462\uFF0C\u5E7F\u544A\u8001\u662F\u788D\u7740\u6211\u6253\u5B57"
    options: []
  - type: 1
    text: "\u8FD9\u4E2A\u5C31\u662F\u4E00\u4E2A\u5F88\u5178\u578B\u7684\u5E7F\u544A\u8F6F\u4EF6\uFF0C\u5B83\u4EEC\u5C31\u9760\u8FD9\u4E9B\u5E7F\u544A\u6765\u8D5A\u94B1\u7684\uFF0C\u6211\u5148\u5E2E\u60A8\u628A\u8FD9\u4E2A\u5220\u4E86\uFF0C\u7136\u540E\u4E0B\u4E2A\u6CA1\u5E7F\u544A\u7684\u8BB0\u8D26\u8F6F\u4EF6\u3002"
    options: []
