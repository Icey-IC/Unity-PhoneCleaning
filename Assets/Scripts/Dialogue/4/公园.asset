  m_Script: {fileID: 11500000, guid: ee501b7d79b0bf645a5a94c1351e1ea5, type: 3}
  m_Name: "\u516C\u56ED"
  m_EditorClassIdentifier: 
  lines:
  - type: 0
    text: "\u516C\u56ED\u4E0D\u4EC5\u662F\u4E2A\u905B\u9E1F\u7684\u597D\u5730\u65B9\uFF0C\u7A7A\u6C14\u6E05\u65B0\uFF0C\u4EBA\u591A\u4E5F\u70ED\u95F9\uFF0C\u8FD9\u4E2A\u80FD\u63D0\u9192\u6211\u54EA\u4E2A\u516C\u56ED\u6709\u4EC0\u4E48\u6D3B\u52A8\u4E3E\u529E\uFF0C\u5F88\u65B9\u4FBF\u5462\u3002"
    options: []
  - type: 0
    text: "\u4F46\u542C\u65C1\u8FB9\u7684\u8001\u5934\u8BF4\u6211\u8FD8\u662F\u9519\u8FC7\u4E86\u8DF3\u86A4\u5E02\u573A\u7684\u6D3B\u52A8\uFF0C\u5E2E\u6211\u628A\u8FD9\u4E2A\u7684\u901A\u77E5\u5F00\u5F00\u5427\uFF0C\u4E0B\u6B21\u6211\u5C31\u80FD\u597D\u597D\u5B89\u6392\u4E86"
    options: []
