  - type: 1
    text: "\u8FD9\u5E74\u5934\u7504\u522B\u8F6F\u4EF6\u786E\u5B9E\u5F88\u6697\uFF0C\u6211\u6765\u5E2E\u60A8\u641E\u5C31\u884C\uFF01"
