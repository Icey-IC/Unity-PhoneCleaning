  lines:
  - type: 0
    text: "\u91CC\u9762\u7684\u8F6F\u4EF6\u79CD\u7C7B\u770B\u7684\u6211\u5934\u6655\u773C\u82B1\u7684\uFF0C\u968F\u4FBF\u4E0B\u8F7D\u4E00\u4E2A\u7ADF\u7136\u8FD8\u4E0D\u80FD\u7528\u3002\u8FD9\u6BD4\u770B\u6211\u90A3\u4E9B\u5B66\u751F\u7684\u9B3C\u5B57\u8FD8\u8981\u8D39\u773C\u775B\u554A"
