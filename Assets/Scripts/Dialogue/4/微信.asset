  m_Script: {fileID: 11500000, guid: ee501b7d79b0bf645a5a94c1351e1ea5, type: 3}
  m_Name: "\u5FAE\u4FE1"
  m_EditorClassIdentifier: 
  lines:
  - type: 0
    text: "\u4E4B\u524D\u6709\u4EBA\u5728\u7FA4\u91CC\u53D1\u4E86\u8650\u9E1F\u7684\u89C6\u9891\uFF0C\u771F\u4E0D\u77E5\u9053\u662F\u8C01\u628A\u4ED6\u4EEC\u6559\u6210\u8FD9\u6837\u7684\uFF0C\u65E0\u803B\u7684\u53EA\u4F1A\u5BF9\u5F31\u5C0F\u4E0B\u624B\uFF0C\u5E2E\u6211\u628A\u5B83\u7684\u901A\u77E5\u5173\u4E86\u5427\uFF0C\u603B\u662F\u6709\u4E9B\u9A9A\u6270\u6D88\u606F\u53D1\u8FC7\u6765"
    options: []
  - type: 1
    text: "\u6211\u4E00\u70B9\u4E5F\u4E0D\u6562\u770B\u90A3\u79CD\u4E1C\u897F\uFF0C\u6BCF\u6B21\u77A5\u89C1\u70B9\u90FD\u8BA9\u6211\u53CD\u80C3\u7684\u6D51\u8EAB\u8D77\u9E21\u76AE\u7599\u7629\uFF0C\u771F\u4E0D\u77E5\u9053\u90A3\u4E9B\u4EBA\u600E\u4E48\u4E0B\u53BB\u624B\u7684"
    options: []
