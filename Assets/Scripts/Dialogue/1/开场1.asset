%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ee501b7d79b0bf645a5a94c1351e1ea5, type: 3}
  m_Name: "\u5F00\u573A1"
  m_EditorClassIdentifier: 
  lines:
  - type: 0
    text: "\u5C0F\u4F19\u5B50\uFF0C\u9EBB\u70E6\u4F60\u518D\u5E2E\u6211\u770B\u770B\u624B\u673A\u5427\uFF0C\u6700\u8FD1\u4E0D\u77E5\u9053\u600E\u4E48\u56DE\u4E8B\uFF0C\u53C8\u5F00\u59CB\u5361\u4E86\u3002"
    options: []
  - type: 1
    text: "\u4EA4\u7ED9\u6211\u5427\uFF01"
    options: []
  - type: 1
    text: "\u770B\u6765\u60A8\u513F\u5973\u4ECA\u5929\u53C8\u8FC7\u6765\u4E86"
    options: []
  - type: 0
    text: "\u6CA1\u6709\uFF0C\u4ECA\u5929\u53EA\u6709\u513F\u5B50\u6709\u65F6\u95F4\u8FC7\u6765\uFF0C\u4F46\u8FD8\u597D\u4ED6\u8FC7\u6765\u4E86\uFF0C\u6211\u4E5F\u7EC8\u4E8E\u80FD\u5598\u4E00\u53E3\u6C14"
    options: []
  - type: 1
    text: "\u60A8\u771F\u662F\u8F9B\u82E6\u4E86\uFF0C\u60A8\u4E08\u592B\u6700\u8FD1\u4E00\u5B9A\u53C8\u8BA9\u60A8\u5403\u4E86\u4E0D\u5C11\u82E6"
    options: []
  - type: 0
    text: "\u662F\u554A\uFF0C\u8FD8\u662F\u90A3\u6837\uFF0C\u7529\uFF0C\u6253\uFF0C\u95F9\uFF0C\u9A82"
    options: []
  - type: 0
    text: "\u771F\u5E0C\u671B\u8FD9\u65E5\u5B50\u7684\u5934\u5FEB\u70B9\u5230\u6765\u554A"
    options: []
  - type: 1
    text: "\u4E00\u5B9A\u4F1A\u7684\uFF0C\u4E00\u5B9A\u4F1A\u7684\uFF01\u60A8\u4ECA\u5929\u5C31\u653E\u5FC3\u5728\u6211\u8FD9\u91CC\u6B47\u606F\u4E00\u4F1A\u5427\uFF01\u6211\u4F1A\u5E2E\u60A8\u628A\u624B\u673A\u6574\u7406\u5230\u548C\u65B0\u7684\u4E00\u6837\u7684"
    options: []
  - type: 0
    text: "\u90A3\u53EF\u771F\u662F\u591A\u8C22\u4F60\u4E86\uFF0C\u4E0D\u77E5\u4E3A\u4EC0\u4E48\u548C\u4F60\u5F85\u5728\u4E00\u8D77\u603B\u80FD\u8BA9\u6211\u7545\u6240\u6B32\u8A00\uFF0C\u628A\u96BE\u53D7\u7684\u4E1C\u897F\u4E00\u5410\u4E3A\u51C0\uFF0C\u771F\u795E\u5947\u554A\u3002"
    options: []
