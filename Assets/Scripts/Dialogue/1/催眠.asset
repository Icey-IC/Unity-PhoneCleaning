  m_Script: {fileID: 11500000, guid: ee501b7d79b0bf645a5a94c1351e1ea5, type: 3}
  m_Name: "\u50AC\u7720"
  m_EditorClassIdentifier: 
  lines:
  - type: 0
    text: "\u8FD9\u4E2A\u6211\u6BCF\u5929\u90FD\u4F1A\u70B9\u5F00\u770B\u770B\uFF0C\u4E5F\u4E0D\u77E5\u9053\u4EC0\u4E48\u65F6\u5019\u88C5\u4E0A\u7684\uFF0C\u4F46\u611F\u89C9\u8FD8\u633A\u7075\u7684\uFF0C\u770B\u4E00\u773C\u5FC3\u91CC\u5C31\u8212\u670D\u70B9\u3002"
    options: []
  - type: 2
    text: 
    options:
    - "\u5927\u5A18\u90A3\u53EA\u662F\u8868\u8C61\uFF0C\u8FD9\u79CD\u8F6F\u4EF6\u7279\u522B\u5BB9\u6613\u8FDB\u884C\u7535\u5B50\u8BC8\u9A97\uFF0C\u6211\u8FD8\u662F\u5E2E\u60A8\u5220\u4E86\u5427"
    - "\u8FD9\u79CD\u8F6F\u4EF6\u5F88\u591A\u90FD\u662F\u9A97\u4EBA\u7684\uFF0C\u7ED9\u4EBA\u70B9\u5FC3\u7406\u5B89\u6170\u800C\u5DF2\uFF0C\u7559\u7740\u4E5F\u6CA1\u4EC0\u4E48\u7528\uFF0C\u6211\u5E2E\u60A8\u6E05\u7406\u6389\u5427\u3002"
