  m_Script: {fileID: 11500000, guid: ee501b7d79b0bf645a5a94c1351e1ea5, type: 3}
  m_Name: "\u6253\u5F00\u76F8\u518C"
  m_EditorClassIdentifier: 
  lines:
  - type: 0
    text: "\u6BCF\u6B21\u6253\u5F00\u56FE\u5E93\u770B\u89C1\u5E74\u8F7B\u65F6\u7684\u7167\u7247\u90FD\u4F1A\u611F\u5230\u75DB\u82E6\uFF0C\u81EA\u4ECE\u4ED6\u786E\u8BCA\u540E\u6211\u7684\u751F\u6D3B\u5C31\u77AC\u95F4\u6ED1\u4E86\u4E0B\u53BB\u3002"
    options: []
  - type: 0
    text: "\u5982\u679C\u4ED6\u5728\u53D1\u75C5\u524D\u6B7B\u6389\u81F3\u5C11\u6211\u8FD8\u80FD\uFF0C\u54E6\uFF0C\u4EBA\u8001\u4E86\u5C31\u662F\u559C\u6B22\u81EA\u987E\u81EA\u5520\u53E8\uFF0C\u5C0F\u4F19\u5B50\uFF0C
      \u4F60\u7EE7\u7EED\u5427"
    options: []
  - type: 0
    text: "\u8FD9\u4E2A\u5C31\u653E\u5728\u5916\u9762\u5C31\u884C\uFF0C\u4E0D\u7528\u653E\u6587\u4EF6\u5939\u91CC\u4E86"
    options: []
