  m_Script: {fileID: 11500000, guid: ee501b7d79b0bf645a5a94c1351e1ea5, type: 3}
  m_Name: "\u7ED3\u675F1"
  m_EditorClassIdentifier: 
  lines:
  - type: 0
    text: "\u53C8\u9EBB\u70E6\u4F60\u4E86\uFF0C\u771F\u4E0D\u60F3\u56DE\u53BB\u554A\u3002\u5982\u679C\u4ED6\u80FD\u5F7B\u5E95\u5B89\u9759\u4E0B\u6765\u5C31\u597D\u4E86\uFF0C
      \u660E\u660E\u624B\u673A\u72B6\u6001\u53EF\u4EE5\u6062\u590D\uFF0C\u574F\u6389\u7684\u4EBA\u5373\u4F7F\u8D39\u5FC3\u8D39\u529B\u4E5F\u62C9\u4E0D\u56DE\u6765\u3002"
    options: []
  - type: 1
    text: "\u60A8\u4E5F\u8F9B\u82E6\u4E86\uFF0C\u4ECA\u665A\u597D\u597D\u7761\u4E00\u89C9\u5427\uFF0C\u624B\u673A\u5DF2\u7ECF\u5E2E\u60A8\u6E05\u7406\u5E72\u51C0\u4E86\u3002 "
    options: []
  - type: 1
    text: "\u81F3\u4E8E\u60A8\u7684\u4E08\u592B\uFF0C\u6211\u76F8\u4FE1\u8FD9\u6BB5\u65F6\u95F4\u4E00\u5B9A\u4F1A\u6709\u8F6C\u673A\u7684\uFF0C\u6BD5\u7ADF\u60A8\u5DF2\u7ECF\u51B3\u5B9A\u4E86\u554A\u3002"
    options: []
