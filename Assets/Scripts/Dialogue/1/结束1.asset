  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ee501b7d79b0bf645a5a94c1351e1ea5, type: 3}
  m_Name: "\u7ED3\u675F1"
  m_EditorClassIdentifier: 
  lines:
  - type: 1
    text: "\u5927\u5A18\uFF0C\u60A8\u7684\u624B\u673A\u597D\u4E86"
    options: []
  - type: 0
    text: "\u53C8\u9EBB\u70E6\u4F60\u4E86\uFF0C\u771F\u4E0D\u60F3\u56DE\u53BB\u554A\u3002\u5982\u679C\u4ED6\u80FD\u5F7B\u5E95\u5B89\u9759\u4E0B\u6765\u5C31\u597D\u4E86\uFF0C
      \u660E\u660E\u624B\u673A\u72B6\u6001\u53EF\u4EE5\u6062\u590D\uFF0C\u574F\u6389\u7684\u4EBA\u5373\u4F7F\u8D39\u5FC3\u8D39\u529B\u4E5F\u62C9\u4E0D\u56DE\u6765\u3002"
    options: []
  - type: 0
    text: "\u8BA9\u513F\u5B50\u4E00\u4E2A\u4EBA\u5E94\u4ED8\u4ED6\uFF0C\u8FD8\u662F\u6709\u4E9B\u653E\u4E0D\u4E0B\u5FC3\u554A"
    options: []
  - type: 1
    text: "\u60A8\u4E5F\u522B\u592A\u62C5\u5FC3\u4E86\uFF0C\u8BF4\u4E0D\u5B9A\u8FD9\u6837\u7684\u751F\u6D3B\u9A6C\u4E0A\u5C31\u5230\u5934\u4E86\u5462"
    options: []
  - type: 0
    text: "\u867D\u7136\u6211\u89C9\u5F97\u4E0D\u592A\u53EF\u80FD\uFF0C\u4F46\u8C22\u8C22\u4F60\u7684\u5B89\u6170\u554A\uFF0C\u5C0F\u4F19\u5B50"
    options: []
  - type: 0
    text: "\u8FD9\u6837\u7684\u751F\u6D3B\u8981\u662F\u771F\u7684\u80FD\u5FEB\u70B9\u7ED3\u675F\u5C31\u597D\u4E86"
    options: []
