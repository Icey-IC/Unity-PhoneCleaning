  lines:
  - type: 0
    text: "\u6211\u7528\u8FD9\u4E2A\u548C\u8001\u4F34\u9009\u4E86\u5893\u7891\u7684\u6B3E\u5F0F\u548C\u4F4D\u7F6E\u4EC0\u4E48\u7684\uFF0C\u4F46\u53EF\u60DC\u5979\u8981\u5148\u8FDB\u53BB\u8EBA\u4E00\u4F1A\u4E86\uFF0C\u8FD9\u4E2A\u7684\u901A\u77E5\u5148\u5E2E\u6211\u5173\u4E86\u5427"
    options: []
  - type: 1
    text: "\u60A8\u80FD\u7ED9\u6211\u4E2A\u5730\u5740\u597D\u8BA9\u6211\u4E5F\u53BB\u796D\u62DC\u796D\u62DC\u5979\u5417\uFF1F\u6211\u6709\u70B9\u6000\u5FF5\u5979\u7684\u624B\u827A\u4E86\u3002"
