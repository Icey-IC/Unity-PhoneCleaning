  m_Script: {fileID: 11500000, guid: ee501b7d79b0bf645a5a94c1351e1ea5, type: 3}
  m_Name: "\u5783\u573E"
  m_EditorClassIdentifier: 
  lines:
  - type: 0
    text: "\u6211\u770B\u5B83\u5199\u7740\u4EC0\u4E48\u6E05\u7406\u5783\u573E\uFF0C\u5C31\u4E0B\u4E0B\u6765\u4E86\uFF0C\u8FD9\u6837\u4E5F\u4E0D\u7528\u8001\u6765\u9EBB\u70E6\u4F60\uFF0C\u803D\u8BEF\u4F60\u6B63\u7ECF\u751F\u610F"
    options: []
  - type: 1
    text: "\u60A8\u53EF\u5343\u4E07\u522B\u8FD9\u4E48\u8BF4\uFF0C\u6211\u53EF\u662F\u5F88\u4E50\u4E8E\u5E2E\u52A9\u5927\u5BB6\u6E05\u7406\u624B\u673A\u5462\uFF0C\u800C\u4E14\u4E5F\u80FD\u542C\u5230\u4E0D\u5C11\u6709\u610F\u601D\u7684\u4E1C\u897F\u3002"
    options: []
  - type: 1
    text: "\u81F3\u4E8E\u8FD9\u4E2A\u8F6F\u4EF6\uFF0C\u7F51\u4E0A\u7ECF\u5E38\u6709\u90A3\u79CD\u5E7F\u544A\u5783\u573E\u8F6F\u4EF6\u5047\u626E\u624B\u673A\u6E05\u7406\u5927\u5E08\uFF0C\u60A8\u4E0B\u6B21\u53EF\u8981\u6CE8\u610F\u70B9\u4E86"
    options: []
