  m_Script: {fileID: 11500000, guid: ee501b7d79b0bf645a5a94c1351e1ea5, type: 3}
  m_Name: "\u6296\u97F3\u5783\u573E"
  m_EditorClassIdentifier: 
  lines:
  - type: 0
    text: "\u5728\u54EA\u7684\u5E7F\u544A\u91CC\u770B\u5230\u8BF4\u5237\u8FD9\u4E2A\u89C6\u9891\u53EF\u4EE5\u8D5A\u94B1\u5462\uFF0C\u6211\u60F3\u7740\u5237\u5237\u89C6\u9891\u8FD8\u6709\u94B1\u5012\u4E5F\u4E0D\u9519"
    options: []
  - type: 1
    text: "\u5C31\u662F\u8FD9\u4E2A\u8F6F\u4EF6\u8001\u662F\u7ED9\u60A8\u5F39\u5404\u79CD\u5E7F\u544A\uFF0C\u5B83\u5C31\u662F\u9760\u8FD9\u4E2A\u6323\u94B1\u7684\uFF0C\u800C\u4E14\u5929\u4E0A\u6389\u9985\u997C\u7684\u4E8B\u8FD8\u662F\u5C11\u4FE1\u4E3A\u597D\uFF0C\u5230\u65F6\u5019\u6211\u7ED9\u60A8\u4E0B\u51E0\u4E2A\u6B63\u89C4\u7684\u89C6\u9891\u8F6F\u4EF6"
    options: []
