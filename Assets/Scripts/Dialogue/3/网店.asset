  lines:
  - type: 0
    text: "\u4F60\u4E4B\u524D\u4E0D\u662F\u5EFA\u8BAE\u6211\u4E5F\u5F00\u4E2A\u7F51\u5E97\u597D\u589E\u52A0\u70B9\u989D\u5916\u6536\u5165\uFF0C\u987A\u4FBF\u6E05\u7406\u4E00\u4E0B\u5FEB\u8FC7\u671F\u7684\u5E93\u5B58\u5417"
    options: []
  - type: 0
    text: "\u7ED3\u679C\u9500\u91CF\u8FD8\u4E0D\u9519\uFF0C\u591A\u6323\u4E86\u70B9\u4E5F\u6709\u80FD\u7ED9\u8001\u4F34\u5979\u6362\u70B9\u66F4\u597D\u7684\u4E1C\u897F\u7528\u7528\u4E86"
    options: []
  - type: 1
    text: "\u80FD\u5E2E\u5230\u60A8\u6700\u597D\u4E0D\u8FC7\u4E86"
    options: []
