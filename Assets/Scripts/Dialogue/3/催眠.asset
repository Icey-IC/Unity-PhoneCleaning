  m_Script: {fileID: 11500000, guid: ee501b7d79b0bf645a5a94c1351e1ea5, type: 3}
  m_Name: "\u50AC\u7720"
  m_EditorClassIdentifier: 
  lines:
  - type: 0
    text: "\u4E4B\u524D\u5173\u5E7F\u544A\u65F6\u4E0D\u5C0F\u5FC3\u78B0\u5230\u4E0B\u4E0B\u6765\u4E86\uFF0C\u867D\u7136\u6CA1\u600E\u4E48\u542C\u8BF4\u8FC7\u8FD9\u4E2A\u8F6F\u4EF6\uFF0C\u4F46\u91CC\u9762\u7684\u4E1C\u897F\u786E\u5B9E\u7269\u7F8E\u4EF7\u5EC9\uFF0C\u6211\u4E70\u4E86\u4E0D\u5C11\u653E\u5728\u6742\u8D27\u94FA\u91CC\u4E86"
    options: []
  - type: 1
    text: "\u5636\uFF0C\u8FDE\u6211\u90FD\u5B8C\u5168\u6CA1\u542C\u8FC7\u8FD9\u4E2A\u8F6F\u4EF6\uFF0C\u90A3\u8FD8\u662F\u7ED9\u60A8\u5220\u4E86\u4E3A\u5999\u5427\uFF0C\u4E07\u4E00\u643A\u5E26\u4E86\u4EC0\u4E48\u75C5\u6BD2\u628A\u60A8\u4ED8\u6B3E\u4FE1\u606F\u4EC0\u4E48\u7684\u76D7\u53D6\u4E86\u5C31\u7CDF\u7CD5\u4E86\uFF0C\u542C\u8BF4\u6700\u8FD1\u8FD9\u79CD\u8BC8\u9A97\u624B\u6BB5\u5F88\u6D41\u884C\u554A"
    options: []
