--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ee501b7d79b0bf645a5a94c1351e1ea5, type: 3}
  m_Name: "\u5F00\u573A"
  m_EditorClassIdentifier: 
  lines:
  - type: 1
    text: "\u5927\u7237\u597D\u4E45\u4E0D\u89C1\uFF01\u846C\u793C\u4EC0\u4E48\u7684\u90FD\u641E\u5B9A\u4E86\uFF1F"
    options: []
  - type: 0
    text: "\u662F\u554A\uFF0C\u7EC8\u4E8E\u628A\u5979\u7684\u540E\u4E8B\u90FD\u641E\u5B9A\u4E86\uFF0C\u8FD9\u6837\u6211\u4E5F\u80FD\u653E\u5FC3\u4E00\u4E9B\u4E86"
    options: []
  - type: 1
    text: "\u771F\u662F\u8F9B\u82E6\u60A8\u4E86\uFF0C\u60A8\u6700\u8FD1\u72B6\u6001\u600E\u4E48\u6837\uFF1F\u533B\u751F\u8FD8\u9891\u7E41\u7684\u8FC7\u6765\u627E\u60A8\u5417\uFF1F"
    options: []
  - type: 0
    text: "\u6700\u8FD1\u7A0D\u5FAE\u597D\u70B9\u4E86\uFF0C\u4E5F\u7B97\u5979\u591A\u5C11\u6709\u70B9\u826F\u5FC3"
    options: []
  - type: 0
    text: "\u5728\u5E72\u51FA\u4E86\u90A3\u6837\u7684\u4E8B\u60C5\u540E\uFF0C\u6211\u662F\u65E0\u8BBA\u5982\u4F55\u90FD\u4E0D\u53EF\u80FD\u628A\u8FD9\u5757\u5730\u7ED9\u5979\u4E86"
    options: []
  - type: 1
    text: "\u6211\u652F\u6301\u60A8\u7684\u51B3\u5B9A\uFF01\u4E5F\u8877\u5FC3\u795D\u613F\u60A8\u80FD\u7262\u7262\u63E1\u4F4F\u8FD9\u5757\u5730\u7684\u6240\u6709\u6743"
    options: []
  - type: 0
    text: "\u54C8\u54C8\uFF0C\u8C22\u8C22\u4F60\u7684\u795D\u798F\uFF0C\u8BDD\u8BF4\u56DE\u6765\uFF0C\u5E2E\u6211\u770B\u770B\u624B\u673A\u5427"
    options: []
