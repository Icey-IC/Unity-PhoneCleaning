--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ee501b7d79b0bf645a5a94c1351e1ea5, type: 3}
  m_Name: "\u7ED3\u675F"
  m_EditorClassIdentifier: 
  lines:
  - type: 1
    text: "\u641E\u5B9A\u4E86\uFF0C\u5927\u7237\u60A8\u6765\u68C0\u67E5\u4E00\u4E0B\u5427"
    options: []
  - type: 0
    text: "\u4E0D\u7528\u4E0D\u7528\uFF0C\u4F60\u7684\u624B\u827A\u6211\u653E\u5FC3\u7684\u5F88"
    options: []
  - type: 0
    text: "\u8FD9\u4E48\u4E45\u4EE5\u6765\u5929\u5929\u5173\u7167\u6211\u4EEC\u8FD9\u4E9B\u4E0D\u4F1A\u6298\u817E\u624B\u673A\u7684\u8001\u5BB6\u4F19\u4EEC\uFF0C\u542C\u6211\u4EEC\u7ED9\u4F60\u62B1\u6028\u90A3\u4E9B\u9E21\u6BDB\u849C\u76AE\u7684\u5C0F\u4E8B\uFF0C\u4E5F\u5F88\u8F9B\u82E6\u5427?"
    options: []
  - type: 1
    text: "\u600E\u4E48\u4F1A\uFF0C\u6211\u5F88\u559C\u6B22\u542C\u60A8\u4EEC\u8BB2\u6545\u4E8B\uFF0C\u800C\u4E14\u628A\u60C5\u7EEA\u53D1\u6CC4\u51FA\u6765\u5BF9\u8EAB\u4F53\u4E5F\u5F88\u597D"
    options: []
  - type: 1
    text: "\u6211\u53EF\u662F\u4EE5\u5E2E\u52A9\u5404\u4F4D\u89E3\u51B3\u70E6\u607C\u4E3A\u4E50\u5462"
    options: []
  - type: 0
    text: "\u771F\u662F\u4E2A\u602A\u5B69\u5B50\uFF0C\u4E0D\u8FC7\u8C22\u8C22\u4F60\u5B89\u6170\u6211\u8FD9\u4E2A\u8001\u5934\u4E86"
    options: []
  - type: 0
    text: "\u4E0B\u6B21\u518D\u53BB\u6211\u5E97\u91CC\uFF0C\u6211\u7ED9\u4F60\u591A\u6253\u70B9\u6298\u554A"
    options: []
  - type: 1
    text: "\u90A3\u6211\u5C31\u5148\u63D0\u524D\u8C22\u8C22\u60A8\u4E86!"
    options: []
