  lines:
  - type: 0
    text: "\u5E2E\u6211\u628A\u90A3\u4E9B\u770B\u4E0D\u6E05\u7684\u7167\u7247\u548C\u846C\u793C\u76F8\u5173\u7684\u7167\u7247\u5220\u6389\u5427\uFF0C\u5979\u7684\u4E27\u4E8B\u524D\u51E0\u5929\u5F7B\u5E95\u7ED3\u675F\u4E86\uFF0C\u7559\u7740\u8FD9\u4E9B\u4E5F\u6CA1\u6709\u610F\u4E49\u4E86"
    options: []
  - type: 1
    text: "\u8BF7\u60A8\u8282\u54C0\u987A\u53D8\uFF0C\u4E0D\u8981\u8FFD\u968F\u59BB\u5B50\uFF0C\u53EA\u8981\u7EE7\u7EED\u751F\u6D3B\u4E0B\u53BB\u4E00\u5B9A\u4F1A\u6709\u597D\u4E8B\u53D1\u751F\u7684"
