  lines:
  - type: 0
    text: "\u4E0D\u77E5\u9053\u600E\u4E48\u7684\uFF0C\u6700\u8FD1\u867D\u7136\u62A5\u8B66\u7684\u4E8B\u60C5\u6CA1\u4EC0\u4E48\u8FDB\u5C55\uFF0C\u4F46\u5FC3\u60C5\u5374\u610F\u5916\u7684\u6709\u4E9B\u8F7B\u677E\uFF0C\u548C\u4F60\u4EA4\u6D41\u603B\u662F\u611F\u89C9\u6109\u60A6\uFF0C\u8C22\u8C22\u4F60\u4E86\u5C0F\u5144\u5F1F"
    options: []
  - type: 1
    text: "\u8FD9\u662F\u6211\u5E94\u8BE5\u7684\uFF0C\u671F\u5F85\u60A8\u4E0B\u6B21\u5149\u4E34\uFF0C\u795D\u798F\u60A8\u7684\u8BA1\u5212\u6709\u76F8\u5E94\u7684\u8FDB\u5C55\uFF0C\u5927\u53D4"
