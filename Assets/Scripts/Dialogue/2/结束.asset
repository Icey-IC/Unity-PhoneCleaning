--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ee501b7d79b0bf645a5a94c1351e1ea5, type: 3}
  m_Name: "\u7ED3\u675F"
  m_EditorClassIdentifier: 
  lines:
  - type: 1
    text: "\u597D\u4E86\uFF0C\u5927\u53D4\u60A8\u73B0\u5728\u770B\u770B\u8FD8\u6709\u5E7F\u544A\u5417"
    options: []
  - type: 0
    text: "\u54C8\u54C8\uFF0C\u4F60\u679C\u7136\u9760\u8C31!\u4E0D\u4EC5\u5E7F\u544A\u4E00\u70B9\u6CA1\u6709\uFF0C\u624B\u673A\u53CD\u5E94\u4E5F\u53D8\u5FEB\u4E86!"
    options: []
  - type: 0
    text: "\u8FD9\u6837\u5230\u65F6\u5019\u4E0D\u7BA1\u662F\u62A5\u8B66\u8FD8\u662F\u6293\u62CD\u90FD\u80FD\u7B2C\u4E00\u65F6\u95F4\u5B8C\u6210\u4E86\uFF0C\u771F\u662F\u8C22\u8C22\u4F60\u4E86\u554A"
    options: []
  - type: 1
    text: "\u60A8\u8FC7\u5956\u4E86\uFF0C\u8FD9\u662F\u6211\u7684\u8D23\u4EFB"
    options: []
  - type: 0
    text: "\u548C\u4F60\u4EA4\u6D41\u603B\u662F\u4EE4\u4EBA\u6109\u60A6\uFF0C\u611F\u89C9\u5FC3\u60C5\u90FD\u8F7B\u677E\u4E86\u4E0D\u5C11"
    options: []
  - type: 0
    text: "\u90A3\u4E0B\u6B21\u8FD8\u662F\u9EBB\u70E6\u4F60\u4E86\uFF0C\u8BF4\u4E0D\u5B9A\u6211\u80FD\u5E26\u7740\u597D\u6D88\u606F\u56DE\u6765\u5462"
    options: []
  - type: 1
    text: "\u671F\u5F85\u60A8\u4E0B\u6B21\u5149\u4E34\uFF0C\u795D\u798F\u60A8\u7684\u8BA1\u5212\u6709\u76F8\u5E94\u7684\u8FDB
      \u5C55\uFF0C\u5927\u53D4"
    options: []
