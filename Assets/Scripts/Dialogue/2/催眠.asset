  m_Script: {fileID: 11500000, guid: ee501b7d79b0bf645a5a94c1351e1ea5, type: 3}
  m_Name: "\u50AC\u7720"
  m_EditorClassIdentifier: 
  lines:
  - type: 0
    text: "\u4F60\u60F3\u77E5\u9053\u8FD9\u4E2A\u662F\u4EC0\u4E48\uFF1F\u597D\u50CF\u662F\u4E0D\u77E5\u9053\u54EA\u5929\u51FA\u73B0\u5728\u624B\u673A\u4E0A\u7684\uFF0C\u867D\u7136\u6211\u4E0D\u4FE1\u6559\u8FD9\u4E9B\u7684\u4E1C\u897F\uFF0C\u4F46\u5076\u5C14\u542C\u542C\uFF0C\u611F\u89C9\u5FC3\u7684\u538B\u6291\u611F\u4E5F\u4F1A\u51CF\u8F7B\u70B9"
    options: []
  - type: 2
    text: 
    options:
    - "\u5927\u53D4\uFF0C\u60A8\u6700\u597D\u8FD8\u662F\u522B\u542C\u4FE1\u8FD9\u79CD\u8F6F\u4EF6\u91CC\u8BF4\u7684\u8BDD\uFF0C\u4E07\u4E00\u5B83\u4E5F\u662F\u90A3\u4E9B\u90AA\u6559\u505A\u51FA\u6765\u7684\u4E1C\u897F\u5462\uFF1F\u6211\u8FD8\u662F\u5E2E\u60A8\u5220\u6389\u5427"
    - "\u5927\u53D4\uFF0C\u8FD9\u79CD\u4E1C\u897F\u53EF\u4E0D\u80FD\u968F\u4FBF\u4FE1\u554A\uFF01\u60A8\u8981\u662F\u4E5F\u6C89\u8FF7\u8D77\u8FD9\u79CD\u5B97\u6559\u7684\u8BDD\uFF0C\u90A3\u5C31\u6CA1\u4EBA\u80FD\u652F\u6491\u8FD9\u4E2A\u5BB6\u4E86"
