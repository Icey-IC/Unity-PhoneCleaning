--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ee501b7d79b0bf645a5a94c1351e1ea5, type: 3}
  m_Name: "\u5F00\u573A"
  m_EditorClassIdentifier: 
  lines:
  - type: 0
    text: "\u5466\uFF01\u5C0F\u5144\u5F1F\uFF0C\u5E2E\u6211\u518D\u770B\u770B\u6211\u8FD9\u624B\u673A\u5427\uFF0C\u4E0D\u77E5\u9053\u600E\u4E48\u641E\u7684\u4E00\u6253\u5F00\u5C31\u662F\u5E7F\u544A\uFF0C\u6211\u90FD\u5FEB\u88AB\u5B83\u70E6\u6B7B\u4E86"
    options: []
  - type: 1
    text: "\u4E4B\u524D\u548C\u60A8\u8BF4\u8FC7\uFF0C\u624B\u673A\u4E0D\u7528\u4E86\u5C31\u8981\u5173\u6389\uFF0C\u60A8\u8001\u662F\u5F00\u7740\u754C\u9762\u5E26\u7740\u5B83\u5230\u5904\u8DD1\uFF0C\u5F88\u5BB9\u6613\u4E0B\u5947\u602A\u7684\u4E1C\u897F\u7684\u3002"
    options: []
  - type: 0
    text: "\u6211\u4E5F\u6CA1\u529E\u6CD5\u554A\uFF0C\u65F6\u673A\u8F6C\u77AC\u5373\u901D\uFF0C\u6211\u65E0\u6CD5\u9519\u8FC7\u4EFB\u4F55\u4E00\u4E2A\u53EF\u80FD\u6027"
    options: []
  - type: 1
    text: "\u60A8\u8BF4\u670D\u6211\u4E86\uFF0C\u5BF9\u4E86\uFF0C\u60A8\u59BB\u5B50\u6700\u8FD1\u72B6\u6001\u6709\u6539\u5584\u5417\uFF1F"
    options: []
  - type: 0
    text: "\u8FD8\u662F\u4E00\u5982\u65E2\u5F80\u7684\u5F80\u90A3\u8FB9\u8DD1\uFF0C\u6211\u65E0\u6CD5\u963B\u62E6\u5979"
    options: []
  - type: 1
    text: "\u60A8\u5DF2\u7ECF\u5F88\u52AA\u529B\u4E86\uFF01\u6211\u76F8\u4FE1\u9A6C\u4E0A\u4E8B\u60C5\u5C31\u4F1A\u51FA\u73B0\u8F6C\u673A\u7684\uFF01"
    options: []
  - type: 0
    text: "\u8C22\u8C22\u4F60\u7684\u5B89\u6170\u4E86"
    options: []
